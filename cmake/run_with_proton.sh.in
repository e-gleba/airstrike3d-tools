#!/usr/bin/env bash
# run_with_proton.sh.in — launch a Windows game via Proton (logcat-style diagnostics)
# CMake substitutes @game_exe@ at configure time.
#
# Env overrides:
#   PROTON_PATH / --proton=<dir>   Proton toolkit directory (contains ./proton)
#   STEAM_RUNTIME_PATH / --runtime=<dir>  Steam Linux Runtime dir (contains _v2-entry-point)
#   PROTON_PREFIX / --prefix=<dir>  compat-data dir (contains pfx/); default ~/.proton_prefixes/<exe>
#   STEAM_ROOT                      Steam root override (default auto-detect)
#   STEAM_COMPAT_APP_ID / --appid=<id>     default 0 (non-Steam game)
#   PROTON_FORCE_LARGE_ADDRESS_AWARE=0 / --no-laa  disable LAA workaround
#   PROTON_FSR4_UPGRADE=1 / --fsr4  re-enable Proton 11 FSR4 DLL copy (default 0)
#   MESA_EXTENSION_MAX_YEAR          default 2003 (era-appropriate GL extensions)

set -Eeuo pipefail
set -o errtrace
shopt -s nullglob

# ─── Paths ────────────────────────────────────────────────────────────────────
readonly EXE="@game_exe@"
readonly DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
readonly STARTED_AT="$(date +%Y%m%d-%H%M%S)"
readonly LOG_DIR="$DIR/logs"
readonly LOG_FILE="$LOG_DIR/$STARTED_AT.log"
mkdir -p "$LOG_DIR"

# Keep only the 20 most recent run logs
find "$LOG_DIR" -maxdepth 1 -type f -name '*.log' -printf '%T@\t%p\0' 2>/dev/null |
    sort -zrn | tail -zn +21 | cut -zf2- | xargs -0r rm -f -- || true

# ─── Fixed FDs (the real fix for the duplication bug) ─────────────────────────
# FD 8 → terminal (snapshot of original stdout) ; FD 9 → log file.
# _emit() writes ONLY to these two, so it is immune to any later stdout/stderr
# juggling (process substitutions, pipes, tees, etc).
exec 8>&1
exec 9>>"$LOG_FILE"

# ─── Colors (terminal only) ───────────────────────────────────────────────────
if [[ -t 8 && -z "${NO_COLOR:-}" ]]; then
    C_RST=$'\033[0m'
    C_TS=$'\033[90m'
    C_TAG=$'\033[35m'
    C_E=$'\033[1;31m'
    C_W=$'\033[1;33m'
    C_I=$'\033[36m'
    C_S=$'\033[1;32m'
    C_D=$'\033[2;37m'
else
    C_RST=
    C_TS=
    C_TAG=
    C_E=
    C_W=
    C_I=
    C_S=
    C_D=
fi
readonly C_RST C_TS C_TAG C_E C_W C_I C_S C_D

# ─── Logger ───────────────────────────────────────────────────────────────────
_emit() { # _emit LEVEL TAG MESSAGE...
    local lvl="$1" tag="$2"
    shift 2
    local msg="$*" ts color label
    printf -v ts '%(%Y-%m-%d %H:%M:%S)T' -1
    case "$lvl" in
    E)
        color=$C_E
        label='ERROR'
        ;;
    W)
        color=$C_W
        label='WARN '
        ;;
    I)
        color=$C_I
        label='INFO '
        ;;
    S)
        color=$C_S
        label=' OK  '
        ;;
    D)
        color=$C_D
        label='DEBUG'
        ;;
    *)
        color=
        label="$lvl"
        ;;
    esac
    printf '%s[%s]%s %s[%s]%s %s[%-9s]%s %s\n' \
        "$C_TS" "$ts" "$C_RST" \
        "$color" "$label" "$C_RST" \
        "$C_TAG" "$tag" "$C_RST" \
        "$msg" >&8
    printf '[%s] [%s] [%-9s] %s\n' "$ts" "$label" "$tag" "$msg" >&9
}

log() { _emit "$1" "${TAG:-launcher}" "${*:2}"; }
die() {
    _emit E "${TAG:-launcher}" "$*"
    exit 1
}

# Strip any pre-existing "[date time] [LEVEL] [tag] " prefix so re-wrapping
# is impossible even if some tool echoes back our formatted lines.
_strip_prefix='^\[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]+\] \[[A-Z ]+\] \[[^]]+\] *'

# Reads stdin line-by-line and emits with auto-promoted severity.
# Known-benign Proton 11 noise is demoted BEFORE error promotion so the real
# fatal line stands out: amdxcffx64.dll optional FSR4 copy, OpenVR/OpenXR
# init failures on a 2003 engine with no VR headset.
pipe_log() { # pipe_log DEFAULT_LEVEL TAG
    local lvl="$1" tag="$2" line lc
    while IFS= read -r line; do
        [[ "$line" =~ $_strip_prefix ]] && line="${line#${BASH_REMATCH[0]}}"
        [[ -z "$line" ]] && continue
        lc=${line,,}
        case "$lc" in
        *amdxcffx64.dll*) _emit W "$tag" "$line (benign: Proton 11 optional FSR4 copy)" ;;
        *openvr* | *openxr*) _emit W "$tag" "$line" ;;
        *ntsync:\ up\ and\ running*) _emit I "$tag" "$line" ;;
        *fatal* | *segfault* | *panic* | *assertion* | *abort*) _emit E "$tag" "$line" ;;
        *error* | *err:* | *failed* | *failure* | *exception*) _emit E "$tag" "$line" ;;
        *warn* | *warning* | *deprecat*) _emit W "$tag" "$line" ;;
        *) _emit "$lvl" "$tag" "$line" ;;
        esac
    done
}

trap 's=$?; TAG=launcher log E "trap ERR  line=$LINENO  cmd=${BASH_COMMAND}  status=$s"' ERR

# ─── Flags ────────────────────────────────────────────────────────────────────
DEBUG=0
TRACE=0
CLEAR_PRELOAD=0
USE_WINED3D=0
NO_LAA=0
USE_FSR4=0
NO_NTSYNC=0
NO_ESYNC=0
NO_FSYNC=0
SINGLE_CORE=0
APP_ID="${STEAM_COMPAT_APP_ID:-0}"
CUSTOM_PROTON="${PROTON_PATH:-}"
CUSTOM_RUNTIME="${STEAM_RUNTIME_PATH:-}"
CUSTOM_PREFIX="${PROTON_PREFIX:-}"
ARGS=()
for a in "$@"; do
    case "$a" in
    --debug) DEBUG=1 ;;
    --trace)
        TRACE=1
        DEBUG=1
        ;;
    --no-preload) CLEAR_PRELOAD=1 ;;
    --wined3d) USE_WINED3D=1 ;;
    --no-laa) NO_LAA=1 ;;
    --fsr4) USE_FSR4=1 ;;
    --no-ntsync) NO_NTSYNC=1 ;;
    --no-esync) NO_ESYNC=1 ;;
    --no-fsync) NO_FSYNC=1 ;;
    --single-core) SINGLE_CORE=1 ;;
    --appid=*) APP_ID="${a#--appid=}" ;;
    --proton=*) CUSTOM_PROTON="${a#--proton=}" ;;
    --runtime=*) CUSTOM_RUNTIME="${a#--runtime=}" ;;
    --prefix=*) CUSTOM_PREFIX="${a#--prefix=}" ;;
    -h | --help)
        cat <<EOF
Usage: $(basename "$0") [--debug] [--trace] [--no-preload] [--wined3d] [--no-laa]
                  [--fsr4] [--no-ntsync] [--no-esync] [--no-fsync] [--single-core]
                  [--appid=ID] [--proton=DIR] [--runtime=DIR] [--prefix=DIR]
                  [-- game args...]
  --debug        Enable Proton/Wine debug logs
  --trace        Enable shell xtrace (implies --debug)
  --no-preload   Unset LD_PRELOAD before launching
  --wined3d      Use WineD3D instead of DXVK (legacy DirectX fallback)
  --no-laa       Disable PROTON_FORCE_LARGE_ADDRESS_AWARE workaround
  --fsr4         Re-enable Proton 11 FSR4 DLL copy (default: off)
  --no-ntsync    Set PROTON_NO_NTSYNC=1 (legacy threading fallback)
  --no-esync     Set PROTON_NO_ESYNC=1 (legacy sync fallback)
  --no-fsync     Set PROTON_NO_FSYNC=1 (legacy sync fallback)
  --single-core  Pin game to CPU 0 via taskset (2003-era SMP race fallback)
  --appid=ID     Steam compat AppID (default: 0, non-Steam game)
  --proton=DIR   Proton toolkit dir (or PROTON_PATH env)
  --runtime=DIR  Steam Linux Runtime dir (or STEAM_RUNTIME_PATH env)
  --prefix=DIR   Compat-data dir holding pfx/ (or PROTON_PREFIX env)
Logs:            $LOG_DIR
EOF
        exit 0
        ;;
    *) ARGS+=("$a") ;;
    esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# ─── Helpers ──────────────────────────────────────────────────────────────────
pick() {
    local base=$1 req=$2
    shift 2
    local matches=() pat m
    for pat in "$@"; do
        matches=("$base"/$pat)
        IFS=$'\n' matches=($(printf '%s\n' "${matches[@]}" | sort -rV))
        for m in "${matches[@]}"; do
            [[ -d "$m" ]] || continue
            [[ -z "$req" || -e "$m/$req" ]] && {
                printf '%s' "$m"
                return 0
            }
        done
    done
    return 1
}

human_signal() {
    case $1 in
    0) echo "clean exit (0)" ;;
    130) echo "SIGINT / Ctrl+C (130)" ;;
    143) echo "SIGTERM (143)" ;;
    137) echo "SIGKILL (137)" ;;
    139) echo "SIGSEGV / segfault (139)" ;;
    134) echo "SIGABRT (134)" ;;
    3) echo "exit code 3 (legacy engine fatal — see game log, try --wined3d / --no-laa)" ;;
    *) echo "exit code $1" ;;
    esac
}

# ─── Banner ───────────────────────────────────────────────────────────────────
TAG=launcher
log S "──── proton launcher started ────"
log I "exe       : $EXE"
log I "workdir   : $DIR"
log I "log file  : $LOG_FILE"

# ─── System ───────────────────────────────────────────────────────────────────
TAG=system
distro="unknown"
[[ -r /etc/os-release ]] && distro="$(
    . /etc/os-release
    echo "${PRETTY_NAME:-$NAME}"
)"
log I "distro    : $distro"
log I "kernel    : $(uname -sr)"
log I "shell     : bash $BASH_VERSION"
log I "user      : $USER (uid=$EUID)"

if command -v lspci >/dev/null; then
    gpu=$(lspci -nn 2>/dev/null | grep -iE 'vga|3d|display' | head -n1 | sed 's/.*: //') || true
    [[ -n "${gpu:-}" ]] && log I "gpu       : $gpu"
fi
if command -v vulkaninfo >/dev/null; then
    vk=$(vulkaninfo --summary 2>/dev/null | grep -m1 deviceName | sed 's/.*= //') || true
    log I "vulkan    : ${vk:-present}"
else
    log W "vulkaninfo not found — install vulkan-tools to verify GPU drivers"
fi

if [[ -n "${LD_PRELOAD:-}" ]]; then
    log W "LD_PRELOAD is set: '$LD_PRELOAD'"
    if ((CLEAR_PRELOAD)); then
        log I "clearing LD_PRELOAD as requested"
        unset LD_PRELOAD
    else
        log W "pass --no-preload to clear it (common Proton breakage)"
    fi
fi
[[ -r /etc/ld.so.preload ]] && log W "/etc/ld.so.preload exists — may interfere"

# ─── Steam ────────────────────────────────────────────────────────────────────
TAG=steam
steam=""
if [[ -n "${STEAM_ROOT:-}" && -d "$STEAM_ROOT" ]]; then
    steam="$STEAM_ROOT"
else
    for p in \
        "$HOME/.var/app/com.valvesoftware.Steam/data/Steam" \
        "$HOME/.var/app/com.valvesoftware.Steam/.steam/steam" \
        "$HOME/.steam/root" \
        "$HOME/.steam/steam" \
        "$HOME/.local/share/Steam"; do
        [[ -d "$p" ]] && {
            steam=$p
            break
        }
    done
fi
[[ -n "$steam" ]] || die "Steam installation not found (set STEAM_ROOT=...)"
log S "root      : $steam"
readonly COMMON="$steam/steamapps/common"

# ─── Proton ───────────────────────────────────────────────────────────────────
TAG=proton
proton=""
if [[ -n "$CUSTOM_PROTON" ]]; then
    [[ -x "$CUSTOM_PROTON/proton" ]] || die "PROTON_PATH invalid: $CUSTOM_PROTON/proton missing or not executable"
    proton="$CUSTOM_PROTON"
else
    for base in "$COMMON" \
        "$steam/compatibilitytools.d" \
        "$HOME/.local/share/Steam/compatibilitytools.d" \
        "$HOME/.steam/root/compatibilitytools.d"; do
        [[ -d "$base" ]] || continue
        if p=$(pick "$base" proton \
            "Proton - Experimental" "GE-Proton*" "Proton *"); then
            proton="$p"
            break
        fi
    done
    if [[ -z "$proton" ]]; then
        if [[ -d "$COMMON" ]]; then
            log E "contents of $COMMON:"
            while IFS= read -r line; do log E "  $line"; done < <(ls -1 "$COMMON" 2>/dev/null | head -n 30)
        fi
        die "Proton not found in $COMMON (Steam > Settings > Compatibility > install Proton; or pass --proton=DIR / PROTON_PATH=DIR; GE-Proton belongs in $steam/compatibilitytools.d)"
    fi
fi
log S "version   : ${proton##*/}"
log I "path      : $proton"
[[ -x "$proton/proton" ]] || die "proton binary missing or not executable"

# ─── Runtime ──────────────────────────────────────────────────────────────────
TAG=runtime
runtime=()
if [[ -n "$CUSTOM_RUNTIME" ]]; then
    [[ -x "$CUSTOM_RUNTIME/_v2-entry-point" ]] || die "STEAM_RUNTIME_PATH invalid: $CUSTOM_RUNTIME/_v2-entry-point missing"
    runtime=("$CUSTOM_RUNTIME/_v2-entry-point" --verb=run --)
    log S "version   : ${CUSTOM_RUNTIME##*/} (override)"
elif rt=$(pick "$COMMON" _v2-entry-point \
    SteamLinuxRuntime_sniper SteamLinuxRuntime_soldier SteamLinuxRuntime_scout "SteamLinuxRuntime*"); then
    runtime=("$rt/_v2-entry-point" --verb=run --)
    log S "version   : ${rt##*/}"
else
    log W "no Steam Linux Runtime found — launching directly (libc mismatches possible)"
    log W "install via Steam > Library > Tools > 'Steam Linux Runtime 3.0 (sniper)'; late-game crashes / garbled text / exit 3 are typical without it"
fi

# ─── Environment ──────────────────────────────────────────────────────────────
TAG=env
if [[ -n "$CUSTOM_PREFIX" ]]; then
    PFX_ROOT="$CUSTOM_PREFIX"
else
    PFX_ROOT="$HOME/.proton_prefixes/$EXE"
fi
readonly PFX_ROOT
mkdir -p "$PFX_ROOT"
# A pre-created but uninitialised pfx/ (no drive_c) makes Proton fail copying
# files such as amdxcffx64.dll with "No such file or directory". Drop the
# stale shell so Proton re-initialises the prefix itself.
if [[ -d "$PFX_ROOT/pfx" && ! -d "$PFX_ROOT/pfx/drive_c" ]]; then
    log W "removing stale empty prefix $PFX_ROOT/pfx (no drive_c) — Proton will recreate it"
    rm -rf "$PFX_ROOT/pfx"
fi

export STEAM_COMPAT_DATA_PATH="$PFX_ROOT"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$steam"
export STEAM_COMPAT_APP_ID="$APP_ID"
export WINEPREFIX="$PFX_ROOT/pfx"
# 32-bit era engine: lift the 2 GB address ceiling. Late-mission crashes and
# garbled text are the classic exhaustion symptoms. Opt out with --no-laa.
if ((NO_LAA == 0)); then
    export PROTON_FORCE_LARGE_ADDRESS_AWARE="${PROTON_FORCE_LARGE_ADDRESS_AWARE:-1}"
    log I "LAA       : PROTON_FORCE_LARGE_ADDRESS_AWARE=$PROTON_FORCE_LARGE_ADDRESS_AWARE"
fi
# Proton 11 tries an optional FSR4 driver-DLL copy (amdxcffx64.dll) that fails
# noisily on prefixes without it. A 2003 engine has no FSR, so keep it off
# unless explicitly re-enabled with --fsr4.
if ((USE_FSR4 == 0)); then
    export PROTON_FSR4_UPGRADE="${PROTON_FSR4_UPGRADE:-0}"
    log I "FSR4      : PROTON_FSR4_UPGRADE=$PROTON_FSR4_UPGRADE (off; --fsr4 to re-enable)"
fi
# Sync fallbacks for 2003-era threading: ntsync/esync/fsync can expose races
# in old engines. Defaults stay on (fast path); opt out per flag.
if ((NO_NTSYNC == 1)); then
    export PROTON_NO_NTSYNC=1
    log I "sync      : PROTON_NO_NTSYNC=1"
fi
if ((NO_ESYNC == 1)); then
    export PROTON_NO_ESYNC=1
    log I "sync      : PROTON_NO_ESYNC=1"
fi
if ((NO_FSYNC == 1)); then
    export PROTON_NO_FSYNC=1
    log I "sync      : PROTON_NO_FSYNC=1"
fi
# Era-appropriate GL extensions for a 2003 engine; override if a driver needs more.
export MESA_EXTENSION_MAX_YEAR="${MESA_EXTENSION_MAX_YEAR:-2003}"
if ((USE_WINED3D)); then
    export PROTON_USE_WINED3D=1
    log I "renderer  : WineD3D (fallback)"
fi

# ─── Bundle ───────────────────────────────────────────────────────────────────
TAG=bundle
for dll in bass.dll original.dll _original.dll "$EXE"; do
    if [[ -f "$DIR/$dll" ]]; then
        log I "$(ls -l "$DIR/$dll" | awk '{print $5, $9}')"
    else
        log W "missing in deploy dir: $dll"
    fi
done

if ((DEBUG)); then
    export PROTON_LOG=1
    export PROTON_LOG_DIR="$LOG_DIR"
    export WINEDEBUG="${WINEDEBUG:-+loaddll,+module,fixme-all}"
    export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-info}"
    export DXVK_LOG_PATH="$LOG_DIR"
    export VKD3D_DEBUG="${VKD3D_DEBUG:-warn}"
    log I "debug mode: ON"
    log I "WINEDEBUG = $WINEDEBUG"
fi
log I "prefix    : $PFX_ROOT/pfx"
log I "appid     : $APP_ID"

if ((DEBUG)); then
    while IFS= read -r line; do log D "$line"; done < <(
        env | grep -E '^(STEAM_|PROTON_|WINE|DXVK_|VKD3D|MESA_|LD_|VK_|__GL|SDL_)' | sort
    )
fi

# ─── Cleanup ──────────────────────────────────────────────────────────────────
child=""
cleanup() {
    local rc=$?
    trap - EXIT ERR
    if [[ -n "$child" ]]; then
        TAG=shutdown log I "stopping (status: $(human_signal "$rc"))"
        [[ -x "$proton/files/bin/wineserver" ]] &&
            WINEPREFIX="$PFX_ROOT/pfx" "$proton/files/bin/wineserver" -k 2>/dev/null || true
        kill -TERM "-$child" 2>/dev/null || true
        sleep 0.3
        kill -KILL "-$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    fi
    if ((rc == 0)); then
        TAG=launcher log S "──── exited cleanly  (log: $LOG_FILE) ────"
    else
        TAG=launcher log E "──── exited: $(human_signal "$rc")  (log: $LOG_FILE) ────"
        # Failure context: list fresh logs + tail the newest Proton log so the
        # actual game fatal is visible without hunting through LOG_DIR.
        TAG=diag log I "recent logs in $LOG_DIR:"
        while IFS= read -r line; do TAG=diag log I "$line"; done < <(ls -lt "$LOG_DIR" 2>/dev/null | head -n 12)
        newest_proton="$(ls -t "$LOG_DIR"/steam-*.log 2>/dev/null | head -n1 || true)"
        if [[ -n "${newest_proton:-}" ]]; then
            TAG=diag log I "tail of $newest_proton:"
            while IFS= read -r line; do TAG=diag log I "$line"; done < <(tail -n 40 "$newest_proton" 2>/dev/null)
        else
            TAG=diag log I "no steam-*.log — rerun with --debug to capture PROTON_LOG + DXVK logs"
        fi
    fi
    exec 9>&-
    exec 8>&-
    exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# ─── Trace ────────────────────────────────────────────────────────────────────
if ((TRACE)); then
    trace_log="$LOG_DIR/$STARTED_AT.trace.log"
    TAG=trace log I "shell trace -> $trace_log"
    exec {trace_fd}>"$trace_log"
    BASH_XTRACEFD=$trace_fd
    PS4='+ [${BASH_SOURCE##*/}:${LINENO}] '
    set -x
fi

# ─── Launch ───────────────────────────────────────────────────────────────────
TAG=launcher
[[ -f "$DIR/$EXE" ]] || die "executable not found: $DIR/$EXE"
cd "$DIR"
log S "executing: $EXE ${*:-}"

# 2003-era SMP races: optionally pin the whole Proton tree to CPU 0.
launch_prefix=()
if ((SINGLE_CORE == 1)); then
    if command -v taskset >/dev/null; then
        launch_prefix=(taskset -c 0)
        log I "cpu       : pinned to CPU 0 via taskset"
    else
        log W "--single-core ignored: taskset not found"
    fi
fi

# Pipe child stdout/stderr through pipe_log. Because _emit writes to FD 8/9
# only — never to FD 1/2 — these two process substitutions can't possibly
# feed each other anymore.
setsid "${launch_prefix[@]}" "${runtime[@]}" "$proton/proton" run "$EXE" "$@" \
    > >(pipe_log I game/out) \
    2> >(pipe_log W game/err) &
child=$!
log I "pid       : $child"

# A non-zero game exit is data, not a script bug: suspend errexit/ERR trap
# around wait so exit 3 etc. flow to cleanup() without a spurious trap ERR line.
set +e
trap - ERR
wait "$child"
rc=$?
trap 's=$?; TAG=launcher log E "trap ERR  line=$LINENO  cmd=${BASH_COMMAND}  status=$s"' ERR
set -e
exit "$rc"
