#!/usr/bin/env bash
# run_exe.sh.in — unified Windows executable runner (Proton / Wine / Native)
# CMake substitutes @GAME_EXE_NAME@ at configure time.
#
# Backends (auto-detected, overridable via flags):
#   proton  — Steam Proton + Steam Linux Runtime  (Linux, default)
#   wine    — system Wine                          (Linux/macOS fallback)
#   native  — direct .exe execution                (Windows host)

set -Eeuo pipefail
set -o errtrace
shopt -s nullglob

# ─── Paths ────────────────────────────────────────────────────────────────────
readonly EXE="@GAME_EXE_NAME@"
readonly DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
readonly STARTED_AT="$(date +%Y%m%d-%H%M%S)"
readonly LOG_DIR="$DIR/logs"
readonly LOG_FILE="$LOG_DIR/$STARTED_AT.log"
mkdir -p "$LOG_DIR"

find "$LOG_DIR" -maxdepth 1 -type f -name '*.log' -printf '%T@\t%p\0' 2>/dev/null |
    sort -zrn | tail -zn +21 | cut -zf2- | xargs -0r rm -f -- || true

# ─── Fixed FDs ────────────────────────────────────────────────────────────────
exec 8>&1
exec 9>>"$LOG_FILE"

# ─── Colors ───────────────────────────────────────────────────────────────────
if [[ -t 8 && -z "${NO_COLOR:-}" ]]; then
    C_RST=$'\033[0m'
    C_TS=$'\033[90m'
    C_TAG=$'\033[35m'
    C_E=$'\033[1;31m'
    C_W=$'\033[1;33m'
    C_I=$'\033[36m'
    C_S=$'\033[1;32m'
    C_D=$'\033[2;37m'
else
    C_RST=
    C_TS=
    C_TAG=
    C_E=
    C_W=
    C_I=
    C_S=
    C_D=
fi
readonly C_RST C_TS C_TAG C_E C_W C_I C_S C_D

# ─── Logger ───────────────────────────────────────────────────────────────────
_emit() {
    local lvl="$1" tag="$2"
    shift 2
    local msg="$*" ts color label
    printf -v ts '%(%Y-%m-%d %H:%M:%S)T' -1
    case "$lvl" in
    E) color=$C_E ; label='ERROR' ;;
    W) color=$C_W ; label='WARN ' ;;
    I) color=$C_I ; label='INFO ' ;;
    S) color=$C_S ; label=' OK  ' ;;
    D) color=$C_D ; label='DEBUG' ;;
    *) color=      ; label="$lvl" ;;
    esac
    printf '%s[%s]%s %s[%s]%s %s[%-9s]%s %s\n' \
        "$C_TS" "$ts" "$C_RST" \
        "$color" "$label" "$C_RST" \
        "$C_TAG" "$tag" "$C_RST" \
        "$msg" >&8
    printf '[%s] [%s] [%-9s] %s\n' "$ts" "$label" "$tag" "$msg" >&9
}

log() { _emit "$1" "${TAG:-launcher}" "${*:2}"; }
die() { _emit E "${TAG:-launcher}" "$*"; exit 1; }

_strip_prefix='^\[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]+\] \[[A-Z ]+\] \[[^]]+\] *'

pipe_log() {
    local lvl="$1" tag="$2" line lc
    while IFS= read -r line; do
        [[ "$line" =~ $_strip_prefix ]] && line="${line#${BASH_REMATCH[0]}}"
        [[ -z "$line" ]] && continue
        lc=${line,,}
        case "$lc" in
        *fatal*|*segfault*|*panic*|*assertion*|*abort*) _emit E "$tag" "$line" ;;
        *error*|*err:*|*failed*|*failure*|*exception*)  _emit E "$tag" "$line" ;;
        *warn*|*warning*|*deprecat*)                    _emit W "$tag" "$line" ;;
        *) _emit "$lvl" "$tag" "$line" ;;
        esac
    done
}

trap 's=$?; TAG=launcher log E "trap ERR  line=$LINENO  cmd=${BASH_COMMAND}  status=$s"' ERR

# ─── Flags ────────────────────────────────────────────────────────────────────
BACKEND=""
DEBUG=0
TRACE=0
CLEAR_PRELOAD=0
ARGS=()
for a in "$@"; do
    case "$a" in
    --proton)  BACKEND=proton ;;
    --wine)    BACKEND=wine   ;;
    --native)  BACKEND=native ;;
    --debug)   DEBUG=1        ;;
    --trace)   TRACE=1; DEBUG=1 ;;
    --no-preload) CLEAR_PRELOAD=1 ;;
    -h|--help)
        cat <<EOF
Usage: $(basename "$0") [--proton|--wine|--native] [--debug] [--trace] [--no-preload] [-- game args...]
  --proton       Force Steam Proton backend
  --wine         Force system Wine backend
  --native       Force native execution (Windows host)
  --debug        Enable debug logs (WINEDEBUG, DXVK_LOG, etc.)
  --trace        Enable shell xtrace (implies --debug)
  --no-preload   Unset LD_PRELOAD before launching
Logs:            $LOG_DIR
EOF
        exit 0
        ;;
    *) ARGS+=("$a") ;;
    esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# ─── Helpers ──────────────────────────────────────────────────────────────────
pick() {
    local base=$1 req=$2
    shift 2
    local matches=() pat m
    for pat in "$@"; do
        matches=("$base"/$pat)
        IFS=$'\n' matches=($(printf '%s\n' "${matches[@]}" | sort -rV))
        for m in "${matches[@]}"; do
            [[ -d "$m" ]] || continue
            [[ -z "$req" || -e "$m/$req" ]] && { printf '%s' "$m"; return 0; }
        done
    done
    return 1
}

human_signal() {
    case $1 in
    0)   echo "clean exit (0)"        ;;
    130) echo "SIGINT / Ctrl+C (130)"  ;;
    143) echo "SIGTERM (143)"          ;;
    137) echo "SIGKILL (137)"          ;;
    139) echo "SIGSEGV / segfault (139)" ;;
    134) echo "SIGABRT (134)"          ;;
    *)   echo "exit code $1"           ;;
    esac
}

detect_os() {
    local os="$(uname -s)"
    case "$os" in
    Linux)   echo linux   ;;
    Darwin)  echo macos   ;;
    CYGWIN*|MINGW*|MSYS*) echo windows ;;
    *)       echo "$os"   ;;
    esac
}

# ─── Platform detection ───────────────────────────────────────────────────────
readonly OS=$(detect_os)

if [[ -z "$BACKEND" ]]; then
    case "$OS" in
    windows) BACKEND=native ;;
    linux)
        steam_root=""
        for p in \
            "$HOME/.var/app/com.valvesoftware.Steam/data/Steam" \
            "$HOME/.var/app/com.valvesoftware.Steam/.steam/steam" \
            "$HOME/.steam/root" \
            "$HOME/.local/share/Steam"; do
            [[ -d "$p" ]] && { steam_root=$p; break; }
        done
        if [[ -n "$steam_root" ]]; then
            BACKEND=proton
        elif command -v wine >/dev/null 2>&1; then
            BACKEND=wine
        else
            die "no backend available — install Steam/Proton or Wine"
        fi
        ;;
    macos)
        if command -v wine >/dev/null 2>&1 || command -v wine64 >/dev/null 2>&1; then
            BACKEND=wine
        else
            die "no backend available on macOS — install Wine (brew install wine-stable)"
        fi
        ;;
    *) die "unsupported OS: $OS" ;;
    esac
fi

# ─── Banner ───────────────────────────────────────────────────────────────────
TAG=launcher
log S "──── runner started  (backend: ${BACKEND}) ────"
log I "exe       : $EXE"
log I "workdir   : $DIR"
log I "log file  : $LOG_FILE"
log I "platform  : $OS"

# ─── System info ──────────────────────────────────────────────────────────────
TAG=system
if [[ "$OS" == "linux" ]]; then
    distro="unknown"
    [[ -r /etc/os-release ]] && distro="$(. /etc/os-release; echo "${PRETTY_NAME:-$NAME}")"
    log I "distro    : $distro"
fi
log I "kernel    : $(uname -sr)"
log I "shell     : bash $BASH_VERSION"
log I "user      : $USER (uid=$EUID)"

if command -v lspci >/dev/null 2>&1; then
    gpu=$(lspci -nn 2>/dev/null | grep -iE 'vga|3d|display' | head -n1 | sed 's/.*: //') || true
    [[ -n "${gpu:-}" ]] && log I "gpu       : $gpu"
fi
if command -v vulkaninfo >/dev/null 2>&1; then
    vk=$(vulkaninfo --summary 2>/dev/null | grep -m1 deviceName | sed 's/.*= //') || true
    log I "vulkan    : ${vk:-present}"
else
    log W "vulkaninfo not found — install vulkan-tools to verify GPU drivers"
fi

if [[ -n "${LD_PRELOAD:-}" ]]; then
    log W "LD_PRELOAD is set: '$LD_PRELOAD'"
    if ((CLEAR_PRELOAD)); then
        log I "clearing LD_PRELOAD as requested"
        unset LD_PRELOAD
    else
        log W "pass --no-preload to clear it (common Proton/Wine breakage)"
    fi
fi
[[ -r /etc/ld.so.preload ]] && log W "/etc/ld.so.preload exists — may interfere"

# ─── Backend: native (Windows host) ───────────────────────────────────────────
if [[ "$BACKEND" == "native" ]]; then
    TAG=launcher
    [[ -f "$DIR/$EXE" ]] || die "executable not found: $DIR/$EXE"
    cd "$DIR"
    log S "executing natively: $EXE ${*:-}"

    "$DIR/$EXE" "$@" \
        > >(pipe_log I game/out) \
        2> >(pipe_log W game/err) &
    child=$!
    log I "pid       : $child"

    trap 'rc=$?; [[ -n "${child:-}" ]] && kill -TERM "-$child" 2>/dev/null || true; wait "$child" 2>/dev/null || true; TAG=launcher log I "exited: $(human_signal $rc)"; exit $rc' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    wait "$child"
    exit $?
fi

# ─── Backend: proton ──────────────────────────────────────────────────────────
if [[ "$BACKEND" == "proton" ]]; then
    TAG=steam
    steam=""
    for p in \
        "$HOME/.var/app/com.valvesoftware.Steam/data/Steam" \
        "$HOME/.var/app/com.valvesoftware.Steam/.steam/steam" \
        "$HOME/.steam/root" \
        "$HOME/.local/share/Steam"; do
        [[ -d "$p" ]] && { steam=$p; break; }
    done
    [[ -n "$steam" ]] || die "Steam installation not found"
    log S "steam     : $steam"
    readonly COMMON="$steam/steamapps/common"

    TAG=proton
    proton=$(pick "$COMMON" proton \
        "Proton - Experimental" "GE-Proton*" "Proton *") || die "Proton not found in $COMMON"
    log S "proton    : ${proton##*/}"
    log I "path      : $proton"
    [[ -x "$proton/proton" ]] || die "proton binary missing or not executable"

    TAG=runtime
    runtime=()
    if rt=$(pick "$COMMON" _v2-entry-point \
        SteamLinuxRuntime_sniper SteamLinuxRuntime_soldier "SteamLinuxRuntime*"); then
        runtime=("$rt/_v2-entry-point" --verb=run --)
        log S "runtime   : ${rt##*/}"
    else
        log W "no Steam Linux Runtime — launching directly (libc mismatches possible)"
    fi

    TAG=env
    readonly PFX_ROOT="$HOME/.proton_prefixes/$EXE"
    mkdir -p "$PFX_ROOT/pfx"
    export STEAM_COMPAT_DATA_PATH="$PFX_ROOT"
    export STEAM_COMPAT_CLIENT_INSTALL_PATH="$steam"
    export MESA_EXTENSION_MAX_YEAR=2003

    if ((DEBUG)); then
        export PROTON_LOG=1
        export PROTON_LOG_DIR="$LOG_DIR"
        export WINEDEBUG="${WINEDEBUG:-+loaddll,+module,fixme-all}"
        export DXVK_LOG_LEVEL="${DXVK_LOG_LEVEL:-info}"
        export DXVK_LOG_PATH="$LOG_DIR"
        export VKD3D_DEBUG="${VKD3D_DEBUG:-warn}"
        log I "debug mode: ON"
    fi
    log I "prefix    : $PFX_ROOT/pfx"

    if ((DEBUG)); then
        while IFS= read -r line; do log D "$line"; done < <(
            env | grep -E '^(STEAM_|PROTON_|WINE|DXVK_|VKD3D|MESA_|LD_|VK_|__GL|SDL_)' | sort
        )
    fi

    TAG=launcher
    [[ -f "$DIR/$EXE" ]] || die "executable not found: $DIR/$EXE"
    cd "$DIR"
    log S "executing: $EXE ${*:-}"

    child=""
    cleanup() {
        local rc=$?
        trap - EXIT ERR
        if [[ -n "$child" ]]; then
            TAG=shutdown log I "stopping (status: $(human_signal "$rc"))"
            [[ -x "$proton/files/bin/wineserver" ]] &&
                WINEPREFIX="$PFX_ROOT/pfx" "$proton/files/bin/wineserver" -k 2>/dev/null || true
            kill -TERM "-$child" 2>/dev/null || true
            sleep 0.3
            kill -KILL "-$child" 2>/dev/null || true
            wait "$child" 2>/dev/null || true
        fi
        if ((rc == 0)); then
            TAG=launcher log S "──── exited cleanly  (log: $LOG_FILE) ────"
        else
            TAG=launcher log E "──── exited: $(human_signal "$rc")  (log: $LOG_FILE) ────"
        fi
        exec 9>&-
        exec 8>&-
        exit "$rc"
    }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    if ((TRACE)); then
        trace_log="$LOG_DIR/$STARTED_AT.trace.log"
        TAG=trace log I "shell trace -> $trace_log"
        exec {trace_fd}>"$trace_log"
        BASH_XTRACEFD=$trace_fd
        PS4='+ [${BASH_SOURCE##*/}:${LINENO}] '
        set -x
    fi

    setsid "${runtime[@]}" "$proton/proton" run "$EXE" "$@" \
        > >(pipe_log I game/out) \
        2> >(pipe_log W game/err) &
    child=$!
    log I "pid       : $child"
    wait "$child"
fi

# ─── Backend: wine ────────────────────────────────────────────────────────────
if [[ "$BACKEND" == "wine" ]]; then
    TAG=wine
    winebin=""
    for cand in wine64 wine; do
        command -v "$cand" >/dev/null 2>&1 && { winebin="$cand"; break; }
    done
    [[ -n "$winebin" ]] || die "wine not found in PATH"

    wine_ver=$("$winebin" --version 2>/dev/null) || wine_ver="unknown"
    log S "wine      : $wine_ver"
    log I "binary    : $(command -v "$winebin")"

    TAG=env
    readonly WINE_PFX="$HOME/.wine_prefixes/$EXE"
    mkdir -p "$WINE_PFX"
    export WINEPREFIX="$WINE_PFX"
    export WINEARCH="${WINEARCH:-win32}"

    if ((DEBUG)); then
        export WINEDEBUG="${WINEDEBUG:-+loaddll,+module,fixme-all}"
        log I "debug mode: ON"
        log I "WINEDEBUG = $WINEDEBUG"
    fi
    log I "prefix    : $WINE_PFX"
    log I "arch      : $WINEARCH"

    TAG=launcher
    [[ -f "$DIR/$EXE" ]] || die "executable not found: $DIR/$EXE"
    cd "$DIR"
    log S "executing: $winebin $EXE ${*:-}"

    child=""
    cleanup() {
        local rc=$?
        trap - EXIT ERR
        if [[ -n "$child" ]]; then
            TAG=shutdown log I "stopping (status: $(human_signal "$rc"))"
            "$winebin" wineserver -k 2>/dev/null || true
            kill -TERM "-$child" 2>/dev/null || true
            sleep 0.3
            kill -KILL "-$child" 2>/dev/null || true
            wait "$child" 2>/dev/null || true
        fi
        if ((rc == 0)); then
            TAG=launcher log S "──── exited cleanly  (log: $LOG_FILE) ────"
        else
            TAG=launcher log E "──── exited: $(human_signal "$rc")  (log: $LOG_FILE) ────"
        fi
        exec 9>&-
        exec 8>&-
        exit "$rc"
    }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    if ((TRACE)); then
        trace_log="$LOG_DIR/$STARTED_AT.trace.log"
        TAG=trace log I "shell trace -> $trace_log"
        exec {trace_fd}>"$trace_log"
        BASH_XTRACEFD=$trace_fd
        PS4='+ [${BASH_SOURCE##*/}:${LINENO}] '
        set -x
    fi

    setsid "$winebin" "$DIR/$EXE" "$@" \
        > >(pipe_log I game/out) \
        2> >(pipe_log W game/err) &
    child=$!
    log I "pid       : $child"
    wait "$child"
fi
