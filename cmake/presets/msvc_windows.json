{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 10,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC x86",
      "description": "VS2022 native 32-bit. Win32 platform, x86 host toolset.",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "toolset": {
        "value": "host=x86",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-build-release",
      "displayName": "MSVC Release Build",
      "configurePreset": "msvc",
      "inherits": "build-release"
    },
    {
      "name": "msvc-build-debug",
      "displayName": "MSVC Debug Build",
      "configurePreset": "msvc",
      "inherits": "build-debug"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-test-release",
      "displayName": "MSVC Test (Release)",
      "description": "Run CTest emulator tests after MSVC Release build",
      "configurePreset": "msvc",
      "inherits": "test-base",
      "configuration": "Release"
    },
    {
      "name": "msvc-test-debug",
      "displayName": "MSVC Test (Debug)",
      "description": "Run CTest emulator tests after MSVC Debug build",
      "configurePreset": "msvc",
      "inherits": "test-base",
      "configuration": "Debug"
    }
  ],
  "packagePresets": [
    {
      "name": "msvc-package",
      "displayName": "MSVC Package",
      "configurePreset": "msvc",
      "configurations": [
        "Release"
      ],
      "generators": [
        "ZIP"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "description": "Configure, build, and package MSVC x86 Release",
      "steps": [
        {
          "type": "configure",
          "name": "msvc"
        },
        {
          "type": "build",
          "name": "msvc-build-release"
        },
        {
          "type": "package",
          "name": "msvc-package"
        }
      ]
    },
    {
      "name": "msvc-release-with-tests",
      "displayName": "MSVC Release (with CTest)",
      "description": "Configure, build, test, and package MSVC x86 Release (requires Steam + Proton)",
      "steps": [
        {
          "type": "configure",
          "name": "msvc"
        },
        {
          "type": "build",
          "name": "msvc-build-release"
        },
        {
          "type": "test",
          "name": "msvc-test-release"
        },
        {
          "type": "package",
          "name": "msvc-package"
        }
      ]
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "description": "Configure and build MSVC x86 Debug",
      "steps": [
        {
          "type": "configure",
          "name": "msvc"
        },
        {
          "type": "build",
          "name": "msvc-build-debug"
        }
      ]
    },
    {
      "name": "msvc-debug-with-tests",
      "displayName": "MSVC Debug (with CTest, no package)",
      "description": "Configure, build, and test MSVC x86 Debug for fast iteration (no packaging)",
      "steps": [
        {
          "type": "configure",
          "name": "msvc"
        },
        {
          "type": "build",
          "name": "msvc-build-debug"
        },
        {
          "type": "test",
          "name": "msvc-test-debug"
        }
      ]
    }
  ]
}
