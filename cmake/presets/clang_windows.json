{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 10,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "clang_windows_x86",
      "displayName": "Clang Windows x86",
      "description": "Native Windows 32-bit build using pure Clang with Ninja (GNU driver, MSVC ABI)",
      "inherits": "ninja-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "x86",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "CMAKE_C_COMPILER_TARGET": "i686-pc-windows-msvc",
        "CMAKE_CXX_COMPILER_TARGET": "i686-pc-windows-msvc",
        "CMAKE_RC_COMPILER": "llvm-rc",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld-link -Xlinker /machine:x86",
        "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld-link -Xlinker /machine:x86",
        "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=lld-link -Xlinker /machine:x86"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang_windows_x86-build-release",
      "displayName": "Clang Windows x86 Release Build",
      "configurePreset": "clang_windows_x86",
      "inherits": "build-release"
    },
    {
      "name": "clang_windows_x86-build-debug",
      "displayName": "Clang Windows x86 Debug Build",
      "configurePreset": "clang_windows_x86",
      "inherits": "build-debug"
    }
  ],
  "testPresets": [
    {
      "name": "clang_windows_x86-test-release",
      "displayName": "Clang Windows x86 Test (Release)",
      "description": "Run CTest emulator tests after Clang Release build",
      "configurePreset": "clang_windows_x86",
      "inherits": "test-base",
      "configuration": "Release"
    },
    {
      "name": "clang_windows_x86-test-debug",
      "displayName": "Clang Windows x86 Test (Debug)",
      "description": "Run CTest emulator tests after Clang Debug build",
      "configurePreset": "clang_windows_x86",
      "inherits": "test-base",
      "configuration": "Debug"
    }
  ],
  "packagePresets": [
    {
      "name": "clang_windows_x86-package",
      "displayName": "Clang Windows x86 Package",
      "configurePreset": "clang_windows_x86",
      "configurations": [
        "Release"
      ],
      "generators": [
        "ZIP"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "clang_windows_x86-release",
      "displayName": "Clang Windows x86 Release",
      "description": "Configure, build, and package Clang Windows x86 Release",
      "steps": [
        {
          "type": "configure",
          "name": "clang_windows_x86"
        },
        {
          "type": "build",
          "name": "clang_windows_x86-build-release"
        },
        {
          "type": "package",
          "name": "clang_windows_x86-package"
        }
      ]
    },
    {
      "name": "clang_windows_x86-release-with-tests",
      "displayName": "Clang Windows x86 Release (with CTest)",
      "description": "Configure, build, test, and package Clang Windows x86 Release (requires Steam + Proton)",
      "steps": [
        {
          "type": "configure",
          "name": "clang_windows_x86"
        },
        {
          "type": "build",
          "name": "clang_windows_x86-build-release"
        },
        {
          "type": "test",
          "name": "clang_windows_x86-test-release"
        },
        {
          "type": "package",
          "name": "clang_windows_x86-package"
        }
      ]
    },
    {
      "name": "clang_windows_x86-debug",
      "displayName": "Clang Windows x86 Debug",
      "description": "Configure and build Clang Windows x86 Debug",
      "steps": [
        {
          "type": "configure",
          "name": "clang_windows_x86"
        },
        {
          "type": "build",
          "name": "clang_windows_x86-build-debug"
        }
      ]
    },
    {
      "name": "clang_windows_x86-debug-with-tests",
      "displayName": "Clang Windows x86 Debug (with CTest, no package)",
      "description": "Configure, build, and test Clang Windows x86 Debug for fast iteration (no packaging)",
      "steps": [
        {
          "type": "configure",
          "name": "clang_windows_x86"
        },
        {
          "type": "build",
          "name": "clang_windows_x86-build-debug"
        },
        {
          "type": "test",
          "name": "clang_windows_x86-test-debug"
        }
      ]
    }
  ]
}
