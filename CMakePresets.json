{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base Configuration",
      "description": "Base preset containing common project configurations and settings",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON"
      }
    },
    {
      "name": "msvc",
      "displayName": "Microsoft Visual C++",
      "description": "MSVC toolchain configuration with Windows-specific optimizations",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "clang",
      "displayName": "LLVM Clang",
      "description": "Clang toolchain configuration with modern C++ standards and optimizations",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "gcc",
      "displayName": "GNU Compiler Collection",
      "description": "GCC toolchain configuration with GNU-specific optimizations and standards",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "llvm-mingw-base",
      "displayName": "LLVM-MinGW Base",
      "description": "Base configuration for LLVM-MinGW cross-compilation",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "LLVM_MINGW_ROOT": "${sourceDir}/llvm-mingw",
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
        "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY",
        "CMAKE_FIND_ROOT_PATH_MODE_PACKAGE": "ONLY",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_MODULE_LINKER_FLAGS_INIT": "-fuse-ld=lld"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "llvm-mingw-i686",
      "displayName": "LLVM-MinGW Win32 (i686)",
      "description": "Cross-compile for Windows 32-bit using LLVM-MinGW toolchain",
      "inherits": "llvm-mingw-base",
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "i686",
        "CMAKE_C_COMPILER": "${sourceDir}/llvm-mingw/bin/i686-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "${sourceDir}/llvm-mingw/bin/i686-w64-mingw32-clang++",
        "CMAKE_RC_COMPILER": "${sourceDir}/llvm-mingw/bin/llvm-windres",
        "CMAKE_C_COMPILER_TARGET": "i686-w64-windows-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "i686-w64-windows-gnu",
        "CMAKE_SYSROOT": "${sourceDir}/llvm-mingw/i686-w64-mingw32",
        "CMAKE_FIND_ROOT_PATH": "${sourceDir}/llvm-mingw/i686-w64-mingw32",
        "CMAKE_AR": "${sourceDir}/llvm-mingw/bin/llvm-ar",
        "CMAKE_RANLIB": "${sourceDir}/llvm-mingw/bin/llvm-ranlib",
        "CMAKE_RC_FLAGS": "-O coff -I${sourceDir}/llvm-mingw/i686-w64-mingw32/include",
        "CMAKE_RC_OUTPUT_EXTENSION": ".obj"
      },
      "environment": {
        "RC": "${sourceDir}/llvm-mingw/bin/llvm-windres",
        "RCFLAGS": "-O coff -I${sourceDir}/llvm-mingw/i686-w64-mingw32/include"
      }
    },
    {
      "name": "llvm-mingw-x86_64",
      "displayName": "LLVM-MinGW Win64 (x86_64)",
      "description": "Cross-compile for Windows 64-bit using LLVM-MinGW toolchain",
      "inherits": "llvm-mingw-base",
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_C_COMPILER": "${sourceDir}/llvm-mingw/bin/x86_64-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "${sourceDir}/llvm-mingw/bin/x86_64-w64-mingw32-clang++",
        "CMAKE_RC_COMPILER": "${sourceDir}/llvm-mingw/bin/llvm-windres",
        "CMAKE_C_COMPILER_TARGET": "x86_64-w64-windows-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "x86_64-w64-windows-gnu",
        "CMAKE_SYSROOT": "${sourceDir}/llvm-mingw/x86_64-w64-mingw32",
        "CMAKE_FIND_ROOT_PATH": "${sourceDir}/llvm-mingw/x86_64-w64-mingw32",
        "CMAKE_AR": "${sourceDir}/llvm-mingw/bin/llvm-ar",
        "CMAKE_RANLIB": "${sourceDir}/llvm-mingw/bin/llvm-ranlib",
        "CMAKE_RC_FLAGS": "-O coff -I${sourceDir}/llvm-mingw/x86_64-w64-mingw32/include",
        "CMAKE_RC_OUTPUT_EXTENSION": ".obj"
      },
      "environment": {
        "RC": "${sourceDir}/llvm-mingw/bin/llvm-windres",
        "RCFLAGS": "-O coff -I${sourceDir}/llvm-mingw/x86_64-w64-mingw32/include"
      }
    },
    {
      "name": "llvm-mingw-armv7",
      "displayName": "LLVM-MinGW ARM32 (armv7)",
      "description": "Cross-compile for Windows ARM 32-bit using LLVM-MinGW toolchain",
      "inherits": "llvm-mingw-base",
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "armv7",
        "CMAKE_C_COMPILER": "${sourceDir}/llvm-mingw/bin/armv7-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "${sourceDir}/llvm-mingw/bin/armv7-w64-mingw32-clang++",
        "CMAKE_RC_COMPILER": "${sourceDir}/llvm-mingw/bin/llvm-windres",
        "CMAKE_C_COMPILER_TARGET": "armv7-w64-windows-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "armv7-w64-windows-gnu",
        "CMAKE_SYSROOT": "${sourceDir}/llvm-mingw/armv7-w64-mingw32",
        "CMAKE_FIND_ROOT_PATH": "${sourceDir}/llvm-mingw/armv7-w64-mingw32",
        "CMAKE_AR": "${sourceDir}/llvm-mingw/bin/llvm-ar",
        "CMAKE_RANLIB": "${sourceDir}/llvm-mingw/bin/llvm-ranlib",
        "CMAKE_RC_FLAGS": "-O coff -I${sourceDir}/llvm-mingw/armv7-w64-mingw32/include",
        "CMAKE_RC_OUTPUT_EXTENSION": ".obj"
      },
      "environment": {
        "RC": "${sourceDir}/llvm-mingw/bin/llvm-windres",
        "RCFLAGS": "-O coff -I${sourceDir}/llvm-mingw/armv7-w64-mingw32/include"
      }
    },
    {
      "name": "llvm-mingw-aarch64",
      "displayName": "LLVM-MinGW ARM64 (aarch64)",
      "description": "Cross-compile for Windows ARM 64-bit using LLVM-MinGW toolchain",
      "inherits": "llvm-mingw-base",
      "cacheVariables": {
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_C_COMPILER": "${sourceDir}/llvm-mingw/bin/aarch64-w64-mingw32-clang",
        "CMAKE_CXX_COMPILER": "${sourceDir}/llvm-mingw/bin/aarch64-w64-mingw32-clang++",
        "CMAKE_RC_COMPILER": "${sourceDir}/llvm-mingw/bin/llvm-windres",
        "CMAKE_C_COMPILER_TARGET": "aarch64-w64-windows-gnu",
        "CMAKE_CXX_COMPILER_TARGET": "aarch64-w64-windows-gnu",
        "CMAKE_SYSROOT": "${sourceDir}/llvm-mingw/aarch64-w64-mingw32",
        "CMAKE_FIND_ROOT_PATH": "${sourceDir}/llvm-mingw/aarch64-w64-mingw32",
        "CMAKE_AR": "${sourceDir}/llvm-mingw/bin/llvm-ar",
        "CMAKE_RANLIB": "${sourceDir}/llvm-mingw/bin/llvm-ranlib",
        "CMAKE_RC_FLAGS": "-O coff -I${sourceDir}/llvm-mingw/aarch64-w64-mingw32/include",
        "CMAKE_RC_OUTPUT_EXTENSION": ".obj"
      },
      "environment": {
        "RC": "${sourceDir}/llvm-mingw/bin/llvm-windres",
        "RCFLAGS": "-O coff -I${sourceDir}/llvm-mingw/aarch64-w64-mingw32/include"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc",
      "displayName": "MSVC Build",
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "clang",
      "displayName": "Clang Build",
      "configurePreset": "clang",
      "configuration": "Release"
    },
    {
      "name": "gcc",
      "displayName": "GCC Build",
      "configurePreset": "gcc",
      "configuration": "Release"
    },
    {
      "name": "llvm-mingw-i686",
      "displayName": "LLVM-MinGW Win32 Build",
      "configurePreset": "llvm-mingw-i686",
      "configuration": "Release"
    },
    {
      "name": "llvm-mingw-x86_64",
      "displayName": "LLVM-MinGW Win64 Build",
      "configurePreset": "llvm-mingw-x86_64",
      "configuration": "Release"
    },
    {
      "name": "llvm-mingw-armv7",
      "displayName": "LLVM-MinGW ARM32 Build",
