{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "description": "Ninja Multi-Config, compile_commands.json, color diagnostics, bass proxy enabled.",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "USE_BASS_PROXY_LIB": "ON",
        "FETCHCONTENT_QUIET": "OFF"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC x86",
      "description": "Visual Studio 2022 native 32-bit. host=x86 forces 32-bit cl.exe.",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "toolset": {
        "value": "host=x86",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "clang",
      "displayName": "Clang (native)",
      "description": "Native build with system Clang/Clang++.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "llvm-mingw",
      "displayName": "LLVM-MinGW i686",
      "description": "Linux => Windows i686 cross via llvm-mingw toolchain. Auto-downloads if missing.",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm_mingw.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "i686"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-release",
      "hidden": true,
      "configuration": "Release"
    },
    {
      "name": "build-debug",
      "hidden": true,
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "configurePreset": "msvc",
      "inherits": "build-release"
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "configurePreset": "msvc",
      "inherits": "build-debug"
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "configurePreset": "clang",
      "inherits": "build-release"
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "configurePreset": "clang",
      "inherits": "build-debug"
    },
    {
      "name": "llvm-mingw-release",
      "displayName": "LLVM-MinGW Release",
      "configurePreset": "llvm-mingw",
      "inherits": "build-release"
    },
    {
      "name": "llvm-mingw-debug",
      "displayName": "LLVM-MinGW Debug",
      "configurePreset": "llvm-mingw",
      "inherits": "build-debug"
    }
  ],
  "packagePresets": [
    {
      "name": "msvc-package",
      "displayName": "MSVC Package",
      "configurePreset": "msvc",
      "configurations": ["Release"],
      "generators": ["ZIP"]
    },
    {
      "name": "clang-package",
      "displayName": "Clang Package",
      "configurePreset": "clang",
      "configurations": ["Release"],
      "generators": ["ZIP"]
    },
    {
      "name": "llvm-mingw-package",
      "displayName": "LLVM-MinGW Package",
      "configurePreset": "llvm-mingw",
      "configurations": ["Release"],
      "generators": ["TXZ"]
    }
  ],
  "workflowPresets": [
    {
      "name": "msvc",
      "displayName": "MSVC Pipeline",
      "steps": [
        { "type": "configure", "name": "msvc" },
        { "type": "build", "name": "msvc-release" },
        { "type": "package", "name": "msvc-package" }
      ]
    },
    {
      "name": "clang",
      "displayName": "Clang Pipeline",
      "steps": [
        { "type": "configure", "name": "clang" },
        { "type": "build", "name": "clang-release" },
        { "type": "package", "name": "clang-package" }
      ]
    },
    {
      "name": "llvm-mingw",
      "displayName": "LLVM-MinGW Pipeline",
      "steps": [
        { "type": "configure", "name": "llvm-mingw" },
        { "type": "build", "name": "llvm-mingw-release" },
        { "type": "package", "name": "llvm-mingw-package" }
      ]
    }
  ]
}
