{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "description": "Ninja Multi-Config, compile_commands.json, color diagnostics, bass proxy enabled, unity build.",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "USE_BASS_PROXY_LIB": "ON",
        "FETCHCONTENT_QUIET": "OFF",
        "CMAKE_UNITY_BUILD": "ON"
      }
    },
    {
      "name": "windows_msvc_x86",
      "displayName": "Windows MSVC x86",
      "description": "Visual Studio 2022 native 32-bit. host=x86 forces 32-bit cl.exe.",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "toolset": {
        "value": "host=x86",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows_clang_x64",
      "displayName": "Windows Clang x64",
      "description": "Native build with system Clang/Clang++ (x64 host arch).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux_llvm-mingw_i686",
      "displayName": "Linux LLVM-MinGW i686",
      "description": "Linux => Windows i686 cross via llvm-mingw toolchain. Auto-downloads if missing.",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm_mingw.cmake",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "i686"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-release",
      "hidden": true,
      "configuration": "Release"
    },
    {
      "name": "build-debug",
      "hidden": true,
      "configuration": "Debug"
    },
    {
      "name": "windows_msvc_x86-release",
      "displayName": "Windows MSVC x86 (Release)",
      "configurePreset": "windows_msvc_x86",
      "inherits": "build-release"
    },
    {
      "name": "windows_msvc_x86-debug",
      "displayName": "Windows MSVC x86 (Debug)",
      "configurePreset": "windows_msvc_x86",
      "inherits": "build-debug"
    },
    {
      "name": "windows_clang_x64-release",
      "displayName": "Windows Clang x64 (Release)",
      "configurePreset": "windows_clang_x64",
      "inherits": "build-release"
    },
    {
      "name": "windows_clang_x64-debug",
      "displayName": "Windows Clang x64 (Debug)",
      "configurePreset": "windows_clang_x64",
      "inherits": "build-debug"
    },
    {
      "name": "linux_llvm-mingw_i686-release",
      "displayName": "Linux LLVM-MinGW i686 (Release)",
      "configurePreset": "linux_llvm-mingw_i686",
      "inherits": "build-release"
    },
    {
      "name": "linux_llvm-mingw_i686-debug",
      "displayName": "Linux LLVM-MinGW i686 (Debug)",
      "configurePreset": "linux_llvm-mingw_i686",
      "inherits": "build-debug"
    }
  ],
  "packagePresets": [
    {
      "name": "windows_msvc_x86-package",
      "displayName": "Windows MSVC x86 Package",
      "configurePreset": "windows_msvc_x86",
      "configurations": ["Release"],
      "generators": ["ZIP"]
    },
    {
      "name": "windows_clang_x64-package",
      "displayName": "Windows Clang x64 Package",
      "configurePreset": "windows_clang_x64",
      "configurations": ["Release"],
      "generators": ["ZIP"]
    },
    {
      "name": "linux_llvm-mingw_i686-package",
      "displayName": "Linux LLVM-MinGW i686 Package",
      "configurePreset": "linux_llvm-mingw_i686",
      "configurations": ["Release"],
      "generators": ["TXZ"]
    }
  ],
  "workflowPresets": [
    {
      "name": "windows_msvc_x86",
      "displayName": "Windows MSVC x86 Pipeline",
      "steps": [
        { "type": "configure", "name": "windows_msvc_x86" },
        { "type": "build", "name": "windows_msvc_x86-release" },
        { "type": "package", "name": "windows_msvc_x86-package" }
      ]
    },
    {
      "name": "windows_clang_x64",
      "displayName": "Windows Clang x64 Pipeline",
      "steps": [
        { "type": "configure", "name": "windows_clang_x64" },
        { "type": "build", "name": "windows_clang_x64-release" },
        { "type": "package", "name": "windows_clang_x64-package" }
      ]
    },
    {
      "name": "linux_llvm-mingw_i686",
      "displayName": "Linux LLVM-MinGW i686 Pipeline",
      "steps": [
        { "type": "configure", "name": "linux_llvm-mingw_i686" },
        { "type": "build", "name": "linux_llvm-mingw_i686-release" },
        { "type": "package", "name": "linux_llvm-mingw_i686-package" }
      ]
    }
  ]
}
