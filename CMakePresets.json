{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base Configuration",
      "description": "Common cache variables shared by all presets",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "FETCHCONTENT_QUIET": "OFF",
        "USE_BASS_PROXY_LIB": "ON"
      }
    },
    {
      "name": "ninja-base",
      "displayName": "Ninja Base",
      "description": "Ninja Multi-Config generator base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "clang_windows_x86",
      "displayName": "Clang Windows x86",
      "description": "Pure Clang (GCC-style driver) targeting 32-bit Windows with Ninja + LLD. Requires MSVC/Windows SDK for standard libraries.",
      "inherits": "ninja-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang_windows_x86.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "llvm-mingw-base",
      "displayName": "LLVM-MinGW Base",
      "description": "Cross-compilation from Linux to Windows via llvm-mingw toolchain",
      "hidden": true,
      "inherits": "ninja-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm_mingw.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "llvm-mingw-i686",
      "displayName": "LLVM-MinGW Win32 (i686)",
      "description": "Cross-compile for Windows 32-bit x86 (legacy game targets)",
      "inherits": "llvm-mingw-base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "i686"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-release",
      "hidden": true,
      "configuration": "Release"
    },
    {
      "name": "build-debug",
      "hidden": true,
      "configuration": "Debug"
    },
    {
      "name": "clang_windows_x86-build-release",
      "displayName": "Clang Windows x86 Release Build",
      "configurePreset": "clang_windows_x86",
      "inherits": "build-release"
    },
    {
      "name": "clang_windows_x86-build-debug",
      "displayName": "Clang Windows x86 Debug Build",
      "configurePreset": "clang_windows_x86",
      "inherits": "build-debug"
    },
    {
      "name": "llvm-mingw-i686-build-release",
      "displayName": "LLVM-MinGW Win32 Release Build",
      "configurePreset": "llvm-mingw-i686",
      "inherits": "build-release"
    },
    {
      "name": "llvm-mingw-i686-build-debug",
      "displayName": "LLVM-MinGW Win32 Debug Build",
      "configurePreset": "llvm-mingw-i686",
      "inherits": "build-debug"
    }
  ],
  "testPresets": [],
  "packagePresets": [
    {
      "name": "clang_windows_x86-package",
      "displayName": "Clang Windows x86 Package",
      "configurePreset": "clang_windows_x86",
      "configurations": [
        "Release"
      ],
      "generators": [
        "ZIP"
      ]
    },
    {
      "name": "llvm-mingw-i686-package",
      "displayName": "LLVM-MinGW Win32 Package",
      "configurePreset": "llvm-mingw-i686",
      "configurations": [
        "Release"
      ],
      "generators": [
        "TXZ"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "clang_windows_x86-release",
      "displayName": "Clang Windows x86 Release",
      "description": "Configure, build, and package Clang Windows x86 Release",
      "steps": [
        {
          "type": "configure",
          "name": "clang_windows_x86"
        },
        {
          "type": "build",
          "name": "clang_windows_x86-build-release"
        },
        {
          "type": "package",
          "name": "clang_windows_x86-package"
        }
      ]
    },
    {
      "name": "clang_windows_x86-debug",
      "displayName": "Clang Windows x86 Debug",
      "description": "Configure and build Clang Windows x86 Debug",
      "steps": [
        {
          "type": "configure",
          "name": "clang_windows_x86"
        },
        {
          "type": "build",
          "name": "clang_windows_x86-build-debug"
        }
      ]
    },
    {
      "name": "llvm-mingw-i686-release",
      "displayName": "LLVM-MinGW Win32 Release",
      "description": "Configure, build, and package for Windows 32-bit (jobs=1 due to LLD deadlock)",
      "steps": [
        {
          "type": "configure",
          "name": "llvm-mingw-i686"
        },
        {
          "type": "build",
          "name": "llvm-mingw-i686-build-release"
        },
        {
          "type": "package",
          "name": "llvm-mingw-i686-package"
        }
      ]
    },
    {
      "name": "llvm-mingw-i686-debug",
      "displayName": "LLVM-MinGW Win32 Debug",
      "description": "Configure and build for Windows 32-bit (jobs=1 due to LLD deadlock)",
      "steps": [
        {
          "type": "configure",
          "name": "llvm-mingw-i686"
        },
        {
          "type": "build",
          "name": "llvm-mingw-i686-build-debug"
        }
      ]
    }
  ]
}
