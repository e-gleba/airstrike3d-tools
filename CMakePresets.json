      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    }
  ],
  "packagePresets": [
    {
      "name": "msvc-package",
      "displayName": "MSVC Package",
      "configurePreset": "msvc",
      "generators": ["ZIP"]
    },
    {
      "name": "clang-package",
      "displayName": "Clang Package",
      "configurePreset": "clang",
      "generators": ["TGZ", "RPM"]
    },
    {
      "name": "gcc-package",
      "displayName": "GCC Package",
