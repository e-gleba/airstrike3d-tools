      "name": "llvm-mingw-aarch64",
      "displayName": "LLVM-MinGW ARM64 Build",
      "configurePreset": "llvm-mingw-aarch64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "msvc",
      "displayName": "MSVC Tests",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true,
