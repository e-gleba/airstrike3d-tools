#!/usr/bin/env bash
# run_with_proton.sh.in — launch a Windows game via Proton
# cmake substitutes @game_exe_name@ at configure time.
set -euo pipefail

readonly exe_name="@game_exe_name@"
readonly exe_dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

log() { printf '=> %s\n' "$*"; }
die() {
    printf '=> error: %s\n' "$*" >&2
    exit 1
}

# first dir under $1 matching patterns ($3…), optionally containing file $2.
# empty $2 skips the file check. returns newest match via version sort.
find_first() {
    local base=$1 req=$2
    shift 2
    local p m
    for p in "$@"; do
        while IFS= read -r -d '' m; do
            [[ -n "$req" && ! -f "$m/$req" ]] && continue
            printf '%s' "$m"
            return
        done < <(find "$base" -maxdepth 1 -type d -name "$p" -print0 2>/dev/null | sort -rzV)
    done
    return 1
}

# --- steam ---
readonly -a steam_paths=(
    "$HOME/.var/app/com.valvesoftware.Steam/data/Steam"
    "$HOME/.var/app/com.valvesoftware.Steam/.steam/steam"
    "$HOME/.steam/root"
    "$HOME/.local/share/Steam"
)
steam=""
for p in "${steam_paths[@]}"; do [[ -d "$p" ]] && {
    steam=$p
    break
}; done
[[ -z "$steam" ]] && die "steam installation not found"
log "steam => '$steam'"

# --- proton (prefer experimental => ge => numbered) ---
readonly common="$steam/steamapps/common"
proton=$(find_first "$common" proton \
    "Proton - Experimental" "GE-Proton*" "Proton *") ||
    die "proton not found in '$common/'"
log "proton => '${proton##*/}'"

# --- steam linux runtime ---
runtime_cmd=()
if rt=$(find_first "$common" _v2-entry-point \
    SteamLinuxRuntime_sniper SteamLinuxRuntime_soldier "SteamLinuxRuntime*"); then
    runtime_cmd=("$rt/_v2-entry-point" --verb=run --)
    log "runtime => '${rt##*/}'"
else
    log "runtime not found, launching without it"
fi

# --- prefix ---
readonly pfx="$HOME/.proton_prefixes/$exe_name/pfx"
mkdir -p "$pfx"
export STEAM_COMPAT_DATA_PATH="${pfx%/*}"
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$steam"
export MESA_EXTENSION_MAX_YEAR=2003

# --- cleanup (EXIT trap pattern) ---
child_pid=""

cleanup() {
    [[ -z "${child_pid:-}" ]] && return
    log "shutting down"

    [[ -x "$proton/files/bin/wineserver" ]] &&
        WINEPREFIX="$pfx" "$proton/files/bin/wineserver" -k 2>/dev/null || true

    local pgid
    pgid=$(ps -o pgid= -p "$child_pid" 2>/dev/null | tr -d ' ') || true
    if [[ -n "$pgid" ]]; then
        kill -TERM -- "-$pgid" 2>/dev/null || true
        sleep 0.5
        kill -KILL -- "-$pgid" 2>/dev/null || true
    fi
    wait "$child_pid" 2>/dev/null || true
}

trap 'exit 130' INT  # 128 + SIGINT(2)
trap 'exit 143' TERM # 128 + SIGTERM(15)
trap cleanup EXIT

# --- launch ---
cd "$exe_dir"
log "launching '$exe_name'"

setsid "${runtime_cmd[@]}" "$proton/proton" run "$exe_name" "$@" &
child_pid=$!

rc=0
wait "$child_pid" || rc=$?
exit "$rc"