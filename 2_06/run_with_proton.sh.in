#!/usr/bin/env bash

exe_name="@game_exe_name@"
exe_dir="$(dirname "$(realpath "$0")")"

# detect steam installation
if [ -d "$HOME/.var/app/com.valvesoftware.Steam" ]; then
    # flatpak steam
    steam_root="$HOME/.var/app/com.valvesoftware.Steam/data/Steam"
    [ ! -d "$steam_root" ] && steam_root="$HOME/.var/app/com.valvesoftware.Steam/.steam/steam"
elif [ -d "$HOME/.steam/root" ]; then
    # native steam (symlink)
    steam_root="$HOME/.steam/root"
elif [ -d "$HOME/.local/share/Steam" ]; then
    # native steam (direct)
    steam_root="$HOME/.local/share/Steam"
else
    echo "=> steam not found, checked:"
    echo "   - flatpak: ~/.var/app/com.valvesoftware.Steam"
    echo "   - native: ~/.steam/root or ~/.local/share/Steam"
    exit 1
fi

echo "=> using steam: $steam_root"

# find proton (prefer experimental, then GE, then any)
proton_path=""
for candidate in \
    "Proton - Experimental" \
    "GE-Proton"* \
    "Proton "*; do
    test_path="$steam_root/steamapps/common/$candidate"
    if [ -d "$test_path" ] && [ -f "$test_path/proton" ]; then
        proton_path="$test_path"
        break
    fi
done

if [ -z "$proton_path" ]; then
    echo "=> proton not found in $steam_root/steamapps/common/"
    exit 1
fi

echo "=> using proton: $(basename "$proton_path")"

# find runtime
runtime_path=""
for runtime in \
    "SteamLinuxRuntime_sniper" \
    "SteamLinuxRuntime_soldier" \
    "SteamLinuxRuntime"*; do
    test_path="$steam_root/steamapps/common/$runtime"
    if [ -d "$test_path" ] && [ -f "$test_path/_v2-entry-point" ]; then
        runtime_path="$test_path"
        break
    fi
done

if [ -z "$runtime_path" ]; then
    echo "=> runtime not found, trying without it"
    runtime_cmd=()
else
    echo "=> using runtime: $(basename "$runtime_path")"
    runtime_cmd=("$runtime_path/_v2-entry-point" --verb=run --)
fi

# setup prefix
prefix_root="$HOME/.proton_prefixes"
prefix_dir="$prefix_root/$exe_name/pfx"
mkdir -p "$prefix_dir"

export STEAM_COMPAT_DATA_PATH="$prefix_dir/.."
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$steam_root"
export MESA_EXTENSION_MAX_YEAR=2003

cd "$exe_dir" || exit 1

echo "=> launching $exe_name"
"${runtime_cmd[@]}" "$proton_path/proton" run "$exe_name" "$@"
